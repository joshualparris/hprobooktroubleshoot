<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WindowsCrashDoctor</AssemblyName>
    <RootNamespace>WindowsCrashDoctor</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishTrimmed>false</PublishTrimmed>
    <Version>0.2.0-preview.1</Version>
    <FileVersion>0.2.0.0</FileVersion>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <InformationalVersion Condition="'$(SourceRevisionId)' != ''">0.2.0-preview.1+$(SourceRevisionId)</InformationalVersion>
    <InformationalVersion Condition="'$(SourceRevisionId)' == ''">0.2.0-preview.1+local</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../scripts/collect-diagnostics.ps1" LogicalName="WCD.Engine.scripts.collect-diagnostics.ps1" />
    <EmbeddedResource Include="../../scripts/check-public-evidence.ps1" LogicalName="WCD.Engine.scripts.check-public-evidence.ps1" />
    <EmbeddedResource Include="../../windows-crash-doctor/CrashDoctor.psm1" LogicalName="WCD.Engine.windows-crash-doctor.CrashDoctor.psm1" />
    <EmbeddedResource Include="../../windows-crash-doctor/TelemetryAnalysis.psm1" LogicalName="WCD.Engine.windows-crash-doctor.TelemetryAnalysis.psm1" />
    <EmbeddedResource Include="../../windows-crash-doctor/DumpParser.psm1" LogicalName="WCD.Engine.windows-crash-doctor.DumpParser.psm1" />
    <EmbeddedResource Include="../../windows-crash-doctor/FindingModel.psm1" LogicalName="WCD.Engine.windows-crash-doctor.FindingModel.psm1" />
    <EmbeddedResource Include="../../windows-crash-doctor/Reporting.psm1" LogicalName="WCD.Engine.windows-crash-doctor.Reporting.psm1" />
    <EmbeddedResource Include="../../windows-crash-doctor/Invoke-CrashDoctor.ps1" LogicalName="WCD.Engine.windows-crash-doctor.Invoke-CrashDoctor.ps1" />
    <EmbeddedResource Include="../../windows-crash-doctor/Integrations.psm1" LogicalName="WCD.Engine.windows-crash-doctor.Integrations.psm1" />
    <EmbeddedResource Include="../../windows-crash-doctor/Manage-Integrations.ps1" LogicalName="WCD.Engine.windows-crash-doctor.Manage-Integrations.ps1" />
    <EmbeddedResource Include="../../windows-crash-doctor/version.json" LogicalName="WCD.Engine.windows-crash-doctor.version.json" />
    <EmbeddedResource Include="../../windows-crash-doctor/integrations/catalog.json" LogicalName="WCD.Engine.windows-crash-doctor.integrations.catalog.json" />
  </ItemGroup>
</Project>
